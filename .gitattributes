* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
scripts/*.ps1 text eol=crlf
scripts/*.py text eol=lf
*.png binary
*.jar binary
